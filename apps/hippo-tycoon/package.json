{
  "name": "hippo-tycoon",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "test": "bun test test",
    "dev": "vite",
    "build": "vite build --outDir dist/client",
    "build:native": "bun scripts/build-native.ts",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
