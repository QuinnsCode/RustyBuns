// brianfloresblitzing: one static page as Worker assets, no Worker code. `bun run deploy` ships it.
// observability turns on request logs and metrics for the Worker in the Cloudflare dashboard.
{
  "name": "brianfloresblitzing",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "public" },
  // The Cmd/Ctrl+K menu (menu.ts), bundled on dev and deploy; public/menu.js isn't committed.
  "build": { "command": "bun build menu.ts --target=browser --format=esm --minify --outfile=public/menu.js", "watch_dir": "menu.ts" },
  "observability": { "enabled": true }
}
