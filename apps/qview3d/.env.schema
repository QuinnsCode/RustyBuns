# QView3D secrets, by name and 1Password reference only, never values (varlock resolves them at deploy).
# Each is one Password item in the qview3d vault, its value in the built-in password field.
# @plugin(@varlock/1password-plugin@2.0.4)
# @initOp(allowAppAuth=true)
# ---

# Signs the short-lived upload URLs the Worker hands out. Without it uploads answer 503.
# @sensitive @required
UPLOAD_SECRET=op(op://qview3d/upload-secret/password)

# An R2 API token's S3 keys, all three or none: with them, uploads go straight to R2 on presigned PUTs
# (the bucket then needs a CORS rule for PUT from the shops' origins). Without them, uploads go through the Worker.
# @sensitive @optional
R2_ACCOUNT_ID=op(op://qview3d/r2-account-id/password, allowMissing=true)
# @sensitive @optional
R2_ACCESS_KEY_ID=op(op://qview3d/r2-access-key-id/password, allowMissing=true)
# @sensitive @optional
R2_SECRET_ACCESS_KEY=op(op://qview3d/r2-secret-access-key/password, allowMissing=true)

# Meshy, for samples: a shop's own product made from its photos (multi-image-to-3D, billed in Meshy credits).
# Without it, samples answer 503. MESHY_DAILY in rustybuns.config.ts caps how many start a day.
# @sensitive @optional
MESHY_API_KEY=op(op://qview3d/meshy-api-key/password, allowMissing=true)
