# eqosys secrets, by name and 1Password reference only, never values (varlock resolves them at deploy).
# @plugin(@varlock/1password-plugin@2.0.4)
# @initOp(allowAppAuth=true)
# ---

# Signs sessions.
# @sensitive @required
BETTER_AUTH_SECRET=op(op://eqosys/better-auth/password)

# The one account that sees everyone and grants access (its email, in the item's password field). Optional.
# @sensitive
SUPER_ADMIN_EMAIL=op(op://eqosys/admin/password)

# Signs the tokens apps check against /.well-known/jwks.json: one EC P-256 private JWK from `bun scripts/keygen.ts`. Optional.
# @sensitive
EQOSYS_SIGNING_KEY=op(op://eqosys/signing-key/password)

# Social sign-in (GITHUB_CLIENT_ID/SECRET, GOOGLE_CLIENT_ID/SECRET, APPLE_CLIENT_ID/CLIENT_SECRET/APP_BUNDLE_ID) is off until their 1Password items exist: varlock fails a plan on a missing
# item even when optional. Add each pair here and in rustybuns.config.ts together, then the button shows.
# Same for QLAVE_ROSTER_SECRET (op://eqosys/qlave-roster/password, shared with Qlave: signs its POST /q/qlave/roster, QLAVE.md §4):
# add it here and in rustybuns.config.ts once the item exists. Unset, every roster is 401 and pages' own word stands.
# Same for DEPLOY_REPORT_KEY (op://eqosys/deploy-report/password, shared with whoever deploys: signs POST /api/deploys, the
# Ship door, src/deploys.ts). The deploying side reads it as RB_DEPLOY_REPORT_KEY. Unset, every report is 503.
