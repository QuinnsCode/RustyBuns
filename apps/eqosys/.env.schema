# eqosys secrets, by name and 1Password reference only, never values (varlock resolves them at deploy).
# @plugin(@varlock/1password-plugin@2.0.4)
# @initOp(allowAppAuth=true)
# ---

# Signs sessions.
# @sensitive @required
BETTER_AUTH_SECRET=op(op://eqosys/better-auth/secret)

# The one account that sees everyone and grants access. Optional.
# @sensitive
SUPER_ADMIN_EMAIL=op(op://eqosys/admin/email)

# Social sign-in: a button shows once both halves of a provider are set. Optional.
# @sensitive
GITHUB_CLIENT_ID=op(op://eqosys/github/client-id)
# @sensitive
GITHUB_CLIENT_SECRET=op(op://eqosys/github/client-secret)
# @sensitive
GOOGLE_CLIENT_ID=op(op://eqosys/google/client-id)
# @sensitive
GOOGLE_CLIENT_SECRET=op(op://eqosys/google/client-secret)
