# qCRM secrets, by name and 1Password reference only, never values (varlock resolves them at deploy).
# @plugin(@varlock/1password-plugin@2.0.4)
# @initOp(allowAppAuth=true)
# ---

# Signs sessions and salts org ids. Without it nobody signs in.
# @sensitive @required
BETTER_AUTH_SECRET=op(op://qcrm/better-auth/secret)

# The one account above every org. Optional: unset means no super admin.
# @sensitive @optional
SUPER_ADMIN_EMAIL=op(op://qcrm/admin/email, allowMissing=true)

# Github sign-in, both halves or neither: the button shows when both are set.
# @sensitive @optional
GITHUB_CLIENT_ID=op(op://qcrm/github/client-id, allowMissing=true)
# @sensitive @optional
GITHUB_CLIENT_SECRET=op(op://qcrm/github/client-secret, allowMissing=true)

# Google sign-in, both halves or neither: the button shows when both are set.
# @sensitive @optional
GOOGLE_CLIENT_ID=op(op://qcrm/google/client-id, allowMissing=true)
# @sensitive @optional
GOOGLE_CLIENT_SECRET=op(op://qcrm/google/client-secret, allowMissing=true)
