// GENERATED by rustybuns from rustybuns.config.ts. Alchemy owns the real
// infra; this file only feeds RWSDK's local dev. Do not hand-edit.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qcrm",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qcrm-db",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "8201",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "HOOKS",
        "queue": "qcrm-hooks"
      }
    ],
    "consumers": [
      {
        "queue": "qcrm-hooks",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      }
    ]
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://qcrm.qntbr.com"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
