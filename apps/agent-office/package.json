{
  "name": "agent-office-bun",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Agent Office (the 3D office of Claude Code workers) Rusty Buns-ified: on Bun, as one self-contained binary",
  "scripts": {
    "office": "bun scripts/rustybunsify.ts && bun office/bin/agent-office.js",
    "office:update": "bun scripts/update.ts",
    "desktop:build": "bun scripts/rustybunsify.ts compile",
    "desktop:build:all": "bun scripts/rustybunsify.ts compile --all",
    "test": "bun test test"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "three": "0.186.1"
  }
}
