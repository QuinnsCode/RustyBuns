{
  "name": "agentworld",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "imports": {
    "#devtools": {
      "production": "./src/devtoolsOff.ts",
      "default": "./src/devtools.ts"
    }
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun build ./index.html ./about.html --outdir dist/ui --minify --conditions production --public-path=/ --splitting && cp public/og.jpg dist/ui/og.jpg",
    "deploy": "bun run build && bunx wrangler deploy && bun ../../packages/cli/src/index.ts report-deploy --app agentworld",
    "test": "bun test test",
    "devtools": "effect-ui-devtools"
  },
  "dependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@f4cddd0",
    "@rustybuns/util": "^0.1.12",
    "effect": "4.1.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.4",
    "@effect/ui-devtools": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-devtools@f4cddd0",
    "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@f4cddd0",
    "@rustybuns/cli": "^0.1.12",
    "@types/three": "^0.180.0"
  }
}
