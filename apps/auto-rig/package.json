{
  "name": "auto-rig",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build:native": "bun scripts/build-native.ts",
    "test": "bun test test",
    "dev": "vite",
    "build": "bunx rustybuns boundary && vite build --outDir dist/client",
    "desktop:dev": "bunx rustybuns build desktop --dev --check && bunx rustybuns run desktop",
    "desktop:build": "bunx rustybuns build desktop --check",
    "deploy": "bunx rustybuns deploy"
  },
  "dependencies": {
    "@rustybuns/cli": "^0.1.12",
    "@rustybuns/native": "^0.1.12",
    "@rustybuns/rig": "^0.1.12",
    "@rustybuns/shell-bun": "^0.1.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
    "@alchemy.run/hetzner": "2.0.0-beta.84",
    "@alchemy.run/neon": "2.0.0-beta.84",
    "@alchemy.run/railway": "2.0.0-beta.84",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/three": "^0.180.0",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.5",
    "vite": "^6.4.4"
  },
  "overrides": {
    "effect": "4.0.5",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/vitest": "4.0.5"
  }
}
