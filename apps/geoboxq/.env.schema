# GeoBoxQ secrets, by name and 1Password reference only, never values (varlock resolves them at deploy).
# @plugin(@varlock/1password-plugin@2.0.4)
# @initOp(allowAppAuth=true)
# ---

# This deployment's license for the sealed engine; artstewengine answers 402 until the owner marks it paid.
# @sensitive @optional
GEOBOXQ_LICENSE=op(op://qcrm/geoboxq/license, allowMissing=true)

# The shipping aggregator link (src/rates.ts): where /api/rates asks, and its key. Unset, /api/rates answers 501.
# @sensitive @optional
RATES_URL=op(op://qcrm/geoboxq/rates-url, allowMissing=true)
# @sensitive @optional
RATES_KEY=op(op://qcrm/geoboxq/rates-key, allowMissing=true)
