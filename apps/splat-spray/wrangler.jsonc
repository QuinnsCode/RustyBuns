// Super Spy Splat Shot online: the built page as static assets, and one World Durable Object per room
// code (src/edge/worker.ts). `bun run deploy` ships it, then the dashed alias (wrangler.alias.jsonc).
{
  "name": "supersplatspyshot",
  "main": "src/edge/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "binding": "ASSETS", "directory": "dist/ui" },
  "durable_objects": { "bindings": [{ "name": "WORLD", "class_name": "World" }, { "name": "MATCH", "class_name": "Matchmaker" }, { "name": "SIGNUPS", "class_name": "Signups" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }, { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] }, { "tag": "v3", "new_sqlite_classes": ["Signups"] }],
  "observability": { "enabled": true }
}
