<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Apple's privacy manifest: what the app collects (kept in step with https://eqosys.qntbr.com/privacy and the
     App Privacy answers in App Store Connect) and why it reads UserDefaults (the typed name, this install's id, blocks). -->
