// Playground: one static page that lists every app with a way to try it. Assets only, no Worker code,
// so it bills nothing beyond the free static tier. `bun run deploy` ships it.
{
  "name": "rustybuns-playground",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "public" },
  // The Cmd/Ctrl+K menu (menu.ts), bundled on dev and deploy; public/menu.js isn't committed.
  "build": { "command": "bun build menu.ts --target=browser --format=esm --minify --outfile=public/menu.js", "watch_dir": "menu.ts" }
}
