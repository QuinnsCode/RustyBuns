+/** The parts made of small pieces that grow out of the body: horns, claws and teeth, spikes and quills, tufts and manes. */
+const PIECES = /horn|claw|spike|tooth|teeth|beak|talon|tusk|fang|quill|tuft|mane/;
+const TIP = new WeakMap<Beast, Map<number, Float32Array>>();
+/** Each piece part's root-to-tip per vertex (loose.ts `tipOf`), worked out once per beast; null for every other part. */
+function tipFor(beast: Beast, part: number, name: string): Float32Array | null {
+  const parts = beast.model.parts;
+  if (!PIECES.test(name) || parts.every((p) => p.count <= parts[part]!.count)) return null;
+  let byPart = TIP.get(beast);
+  if (!byPart) TIP.set(beast, (byPart = new Map()));
+  let t = byPart.get(part);
+  if (!t) {
+    const g = parts[part]!.geometry, own = g.getAttribute("position").array, body: number[] = [];
+    parts.forEach((p, i) => {
+      const m = Array.isArray(p.material) ? p.material[0] : p.material;
+      if (i !== part && !PIECES.test(m?.name ?? "")) { const a = p.geometry.getAttribute("position").array; for (let k = 0; k < a.length; k++) body.push(a[k]!); }
+    });
+    t = tipOf(own, g.index?.array ?? null, reachOf(own, body, 1, 1));
+    byPart.set(part, t);
+  }
+  return t;
