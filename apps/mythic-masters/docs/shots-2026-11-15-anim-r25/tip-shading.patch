+/** Per vertex of a part made of many small pieces (spikes, horns, claws, fur cards), how far from root to tip it sits
+ * on its own piece, 0 to 1: its distance from the body over the furthest of its piece's. A piece is the triangles that
+ * share a corner (welded by position, since a flat-shaded cone splits every face). `distOut` is `reachOf` at gain 1. */
+export function tipOf(pos: ArrayLike<number>, index: ArrayLike<number> | null, distOut: Float32Array): Float32Array {
+  const n = pos.length / 3, up = new Int32Array(n).map((_, i) => i);
+  const find = (i: number): number => { while (up[i] !== i) i = up[i] = up[up[i]!]!; return i; };
+  const join = (a: number, b: number) => { a = find(a); b = find(b); if (a !== b) up[a] = b; };
+  const at = new Map<string, number>();
+  for (let i = 0; i < n; i++) {
+    const k = `${Math.round(pos[i * 3]! * 1e4)},${Math.round(pos[i * 3 + 1]! * 1e4)},${Math.round(pos[i * 3 + 2]! * 1e4)}`;
+    const j = at.get(k);
+    if (j === undefined) at.set(k, i); else join(i, j);
+  }
+  const corner = (t: number) => (index ? index[t]! : t), corners = index ? index.length : n;
+  for (let t = 0; t + 2 < corners; t += 3) { join(corner(t), corner(t + 1)); join(corner(t), corner(t + 2)); }
+  const far = new Float32Array(n), out = new Float32Array(n);
+  for (let i = 0; i < n; i++) { const r = find(i); far[r] = Math.max(far[r]!, distOut[i]!); }
+  for (let i = 0; i < n; i++) { const f = far[find(i)]!; out[i] = f > 1e-6 ? distOut[i]! / f : 1; }
+  return out;
+}
