+      d1 * (e2[0]! * ny - e2[1]! * nx) + d2 * (nx * e1[1]! - ny * e1[0]!),
+    ];
+    const gl = Math.hypot(g[0]!, g[1]!, g[2]!);
+    if (gl < 1e-20) continue;
+    for (const v of [a, b, c]) for (let k = 0; k < 3; k++) along[key[v]! * 3 + k] += (g[k]! / gl) * Math.sqrt(nn);
+  }
+  const mid = new Map<number, number[]>();
+  for (let w = 0; w < m; w++) {
