+/** Per vertex of a card, where it sits across the card's strands: its rest position (over the model's height `top`) with
+ * the along-the-card part taken out, so it holds still from root to tip. Along is the tip value's gradient, summed over
+ * the triangles at each welded corner (by position) and taken from each card's own middle (the triangles that touch,
+ * welded): a gradient per triangle on the GPU jumped at every edge and drew the triangles as light and dark shards. */
+export function strandOf(pos: ArrayLike<number>, index: ArrayLike<number> | null, tip: ArrayLike<number>, top: number): Float32Array {
+  const n = pos.length / 3, tris = index ? index.length / 3 : n / 3, at = (t: number, k: number) => (index ? index[t * 3 + k]! : t * 3 + k);
+  const key = new Int32Array(n), seen = new Map<string, number>();
+  for (let i = 0; i < n; i++) {
+    const k = `${Math.round(pos[i * 3]! * 1e4)},${Math.round(pos[i * 3 + 1]! * 1e4)},${Math.round(pos[i * 3 + 2]! * 1e4)}`;
+    let w = seen.get(k);
+    if (w === undefined) seen.set(k, (w = seen.size));
+    key[i] = w;
+  }
+  const m = seen.size, along = new Float64Array(m * 3), up = new Int32Array(m).map((_, i) => i);
+  const find = (i: number): number => { while (up[i] !== i) i = up[i] = up[up[i]!]!; return i; };
+  const p = (i: number, k: number) => pos[i * 3 + k]!;
+  for (let t = 0; t < tris; t++) {
+    const a = at(t, 0), b = at(t, 1), c = at(t, 2);
+    const e1 = [p(b, 0) - p(a, 0), p(b, 1) - p(a, 1), p(b, 2) - p(a, 2)], e2 = [p(c, 0) - p(a, 0), p(c, 1) - p(a, 1), p(c, 2) - p(a, 2)];
+    const nx = e1[1]! * e2[2]! - e1[2]! * e2[1]!, ny = e1[2]! * e2[0]! - e1[0]! * e2[2]!, nz = e1[0]! * e2[1]! - e1[1]! * e2[0]!;
+    const nn = nx * nx + ny * ny + nz * nz;
+    const ra = find(key[a]!); up[find(key[b]!)] = ra; up[find(key[c]!)] = ra;
+    if (nn < 1e-20) continue;
+    const d1 = tip[b]! - tip[a]!, d2 = tip[c]! - tip[a]!;
+    // grad = (d1 (e2 x n) + d2 (n x e1)) / |n|^2, scaled by the area (|n|) so big triangles count for more
+    const g = [
