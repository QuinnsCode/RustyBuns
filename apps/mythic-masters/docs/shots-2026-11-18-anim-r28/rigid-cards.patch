+/** Each card moves as one piece. The rigger weights every vertex to the bones it is nearest, so a card that hangs where hip
+ * meets thigh got its root on the hip and its tip on the thigh, and a bend stretched it into a long silver triangle
+ * (#5183 round 28). Here each card (its triangles, welded by position) takes the weights of its root (the vertex
+ * with the least reach), in place in `si`/`sw`: the root stays on the skin and the rest turns with it. */
+export function rigidCards(pos: ArrayLike<number>, index: ArrayLike<number> | null, reach: ArrayLike<number>, si: Uint16Array | number[], sw: Float32Array | number[]): void {
+  const n = pos.length / 3, up = new Int32Array(n);
+  for (let i = 0; i < n; i++) up[i] = i;
+  const find = (a: number) => { while (up[a] !== a) { up[a] = up[up[a]!]!; a = up[a]!; } return a; };
+  const join = (a: number, b: number) => { a = find(a); b = find(b); if (a !== b) up[b] = a; };
+  const tri = index ?? Array.from({ length: n }, (_, i) => i);
+  for (let t = 0; t + 2 < tri.length; t += 3) { join(tri[t]!, tri[t + 1]!); join(tri[t]!, tri[t + 2]!); }
+  const at = new Map<string, number>();
+  for (let i = 0; i < n; i++) {
+    const key = `${Math.round(pos[i * 3]! * 1e4)},${Math.round(pos[i * 3 + 1]! * 1e4)},${Math.round(pos[i * 3 + 2]! * 1e4)}`;
+    const j = at.get(key);
+    if (j === undefined) at.set(key, i); else join(i, j);
+  }
+  const root = new Map<number, number>();
+  for (let i = 0; i < n; i++) { const c = find(i), r = root.get(c); if (r === undefined || reach[i]! < reach[r]!) root.set(c, i); }
+  for (let i = 0; i < n; i++) {
+    const r = root.get(find(i))!;
+    if (r !== i) for (let k = 0; k < 4; k++) { si[i * 4 + k] = si[r * 4 + k]!; sw[i * 4 + k] = sw[r * 4 + k]!; }
+  }
+}
