{
  "name": "mythic-masters",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "test": "bun test test",
    "tune": "bun scripts/tune.ts",
    "beasts": "bun scripts/beasts.ts --render",
    "flora": "bun scripts/flora.ts",
    "desktop:dev": "rustybuns build desktop --dev --check && rustybuns run desktop",
    "desktop:build": "rustybuns build desktop --check",
    "ground": "bun scripts/ground.ts",
    "crowd": "bun scripts/crowd.ts",
    "deploy": "rustybuns deploy",
    "cms": "bun ../../packages/cms/src/cli.ts content --title \"Mythic Masters\" --port 4705"
  },
  "dependencies": {
    "@rustybuns/game-controls": "workspace:*",
    "@rustybuns/rig": "workspace:*",
    "@rustybuns/util": "workspace:*",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
    "@alchemy.run/hetzner": "2.0.0-beta.84",
    "@alchemy.run/neon": "2.0.0-beta.84",
    "@alchemy.run/railway": "2.0.0-beta.84",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@rustybuns/cli": "^0.1.12",
    "@types/three": "^0.180.0",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.5",
    "vite": "^6.2.6",
    "wrangler": "4.141.0"
  },
  "overrides": {
    "effect": "4.0.5",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/vitest": "4.0.5"
  }
}
