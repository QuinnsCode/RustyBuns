{
  "name": "codesplitter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "agents": "bun agents.ts",
    "layout": "bun layout.ts",
    "phone": "bun scripts/phone.ts",
    "stress": "bun scripts/stress.ts",
    "smoke": "bun scripts/smoke.ts",
    "demo-check": "bun scripts/demo-check.ts",
    "welcome": "bun scripts/welcome.ts",
    "borg": "bun scripts/borg-engine.ts",
    "gitpath": "bun src/gitpath/serve.ts",
    "cli": "bun cli.ts",
    "test": "bun test --parallel test",
    "test:watch": "bun test --watch test",
    "desktop": "bun ../../packages/cli/src/index.ts build desktop --dev && bun ../../packages/cli/src/index.ts run desktop",
    "desktop:watch": "bun ../../packages/cli/src/index.ts run desktop --watch",
    "desktop:agent": "bun ../../packages/cli/src/index.ts run desktop --watch --agent",
    "desktop:update": "bun scripts/update.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@babel/parser": "7.28.5",
    "@rustybuns/cli": "workspace:*",
    "@rustybuns/util": "workspace:*",
    "@rustybuns/shell-bun": "workspace:*",
    "better-auth": "1.7.7",
    "lucide": "0.469.0",
    "smol-toml": "1.9.0",
    "three": "0.160.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
    "@effect/platform-bun": "^4.0.5",
    "@effect/platform-node": "^4.0.5",
    "alchemy": "2.0.0-beta.84",
    "effect": "^4.0.5"
  }
}
