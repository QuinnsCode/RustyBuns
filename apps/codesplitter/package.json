{
  "name": "codesplitter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "agents": "bun agents.ts",
    "layout": "bun layout.ts",
    "phone": "bun scripts/phone.ts",
    "cli": "bun cli.ts",
    "test": "bun test --parallel test",
    "test:watch": "bun test --watch test",
    "desktop": "bun ../../packages/cli/src/index.ts build desktop --dev && bun ../../packages/cli/src/index.ts run desktop",
    "desktop:watch": "bun ../../packages/cli/src/index.ts run desktop --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@babel/parser": "7.28.5",
    "@rustybuns/cli": "workspace:*",
    "@rustybuns/shell-bun": "workspace:*",
    "better-auth": "1.7.7",
    "lucide": "0.469.0",
    "smol-toml": "1.9.0",
    "three": "0.160.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.77",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "alchemy": "2.0.0-beta.77",
    "effect": "4.0.0-rc.112"
  }
}
