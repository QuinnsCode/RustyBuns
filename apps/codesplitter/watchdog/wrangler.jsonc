// The watchdog (#1562). The owner deploys it by hand; see README.md.
{
  "name": "codesplitter-watchdog",
  "main": "worker.ts",
  "compatibility_date": "2026-06-01",
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [{ "binding": "STATE", "id": "REPLACE_WITH_KV_ID" }],
  "vars": { "PRIMARY_URL": "", "CF_ACCOUNT_ID": "", "SCRIPT_NAME": "codesplitter", "REPORT_REPO": "" }
}
