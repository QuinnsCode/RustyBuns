{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codesplitter",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "containers": [
    {
      "class_name": "AgentSandbox",
      "image": "sandbox/Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
