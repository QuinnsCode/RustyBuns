    {
      "class_name": "DeployRunner",
      "image": "deploy-sandbox/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codesplitter-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LEVEL_CHUNKS",
      "bucket_name": "codesplitter-level-chunks"
    }
  ],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "codesplitters"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "6470",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "HOOKS",
        "queue": "codesplitter-hooks"
      },
      {
        "binding": "JOBS",
        "queue": "codesplitter-jobs"
      },
      {
        "binding": "FIXES",
        "queue": "codesplitter-fixes"
      },
      {
        "binding": "LEVEL_DIGS",
        "queue": "codesplitter-level-digs"
      }
    ],
    "consumers": [
      {
        "queue": "codesplitter-hooks",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      },
      {
        "queue": "codesplitter-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      },
      {
        "queue": "codesplitter-fixes",
        "max_batch_size": 1,
        "max_batch_timeout": 1
      },
      {
        "queue": "codesplitter-level-digs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 20,
        "max_concurrency": 8
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FILES",
        "class_name": "FileDurableObject"
      },
      {
        "name": "GAMES",
        "class_name": "GameRoom"
      },
      {
        "name": "SEARCH",
        "class_name": "RepoSearch"
      },
      {
        "name": "AGENT_SANDBOX",
        "class_name": "AgentSandbox"
      },
      {
        "name": "DEPLOY_RUNNER",
        "class_name": "DeployRunner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FileDurableObject",
        "GameRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "DeployRunner"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "AgentSandbox"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "RepoSearch"
      ]
