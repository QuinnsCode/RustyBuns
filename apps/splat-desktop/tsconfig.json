  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "types": ["bun", "vite/client"], "lib": ["ESNext", "DOM", "DOM.Iterable"]
