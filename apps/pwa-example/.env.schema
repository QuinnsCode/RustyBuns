# Pocket Dice's Play Store upload key, by 1Password reference only, never values. varlock resolves them when
# `bunx varlock run -- bun run twa build` (or `... twa fingerprint`) runs; nothing else in the app needs a secret.
# Each is one Password item in the pocket-dice vault, its value in the built-in password field.
# @plugin(@varlock/1password-plugin@2.0.4)
# @initOp(allowAppAuth=true)
# ---

# The upload keystore file as one base64 line (`base64 -i upload.keystore`).
# @sensitive @required
TWA_KEYSTORE_B64=op(op://pocket-dice/twa-keystore-b64/password)

# The keystore's password.
# @sensitive @required
TWA_KEYSTORE_PASSWORD=op(op://pocket-dice/twa-keystore-password/password)

# The key's own password, only when it differs from the keystore's.
# @sensitive @optional
TWA_KEY_PASSWORD=op(op://pocket-dice/twa-key-password/password, allowMissing=true)

# The key's alias in the keystore. Not a secret.
# @optional
TWA_KEY_ALIAS=upload
