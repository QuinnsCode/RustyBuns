{
  "name": "fm-daw",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build:native": "bun scripts/build-native.ts",
    "test": "bun test test",
    "bench": "bun bench/engines.ts",
    "dev": "vite",
    "build": "bun scripts/build-native.ts --wasm --optional && bunx rustybuns boundary && vite build --outDir dist/client",
    "desktop:dev": "bunx rustybuns build desktop --dev --check && bunx rustybuns run desktop",
    "desktop:build": "bunx rustybuns build desktop --check"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@rustybuns/cli": "workspace:*",
    "@rustybuns/native": "workspace:*",
    "@rustybuns/shell-bun": "workspace:*",
    "@rustybuns/util": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
    "@effect/platform-bun": "^4.0.5",
    "@effect/platform-node": "^4.0.5",
    "@types/react": "19",
    "@types/react-dom": "19",
    "alchemy": "2.0.0-beta.84",
    "effect": "^4.0.5",
    "vite": "^6.2.6"
  }
