{
  "name": "fm-daw",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build:native": "bun scripts/build-native.ts",
    "test": "bun test test",
    "test:rust": "bun scripts/build-native.ts --wasm && bun test test/circuit.test.ts test/enclosure.test.ts",
    "bench": "bun bench/engines.ts",
    "dev": "vite",
    "build": "bun scripts/build-native.ts --wasm --optional && bunx rustybuns boundary && vite build --outDir dist/client",
    "desktop:dev": "bunx rustybuns build desktop --dev --check && bunx rustybuns run desktop",
    "desktop:build": "bunx rustybuns build desktop --check",
    "deploy": "bunx rustybuns deploy"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@rustybuns/cli": "^0.1.12",
    "@rustybuns/game-controls": "^0.1.12",
    "@rustybuns/gear": "^0.1.12",
    "@rustybuns/models": "^0.1.12",
    "@rustybuns/native": "^0.1.12",
    "@rustybuns/rig": "^0.1.12",
    "@rustybuns/shell-bun": "^0.1.12",
    "@rustybuns/util": "^0.1.12",
    "@webaudiomodules/sdk": "0.0.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.87",
    "@alchemy.run/hetzner": "2.0.0-beta.87",
    "@alchemy.run/neon": "2.0.0-beta.87",
    "@alchemy.run/railway": "2.0.0-beta.87",
    "@effect/platform-bun": "4.1.4",
    "@effect/platform-node": "4.1.4",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/three": "^0.180.0",
    "@webaudiomodules/api": "2.0.0-alpha.6",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4",
    "vite": "^6.4.4"
  },
  "overrides": {
    "effect": "4.1.4",
    "@effect/platform-bun": "4.1.4",
    "@effect/platform-node": "4.1.4",
    "@effect/platform-node-shared": "4.1.4",
    "@effect/vitest": "4.1.4"
  }
