{
  "name": "qwik-example",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --mode ssr",
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "qwik build && wrangler pages deploy ./dist",
    "desktop:dev": "rustybuns build desktop --dev && rustybuns run desktop",
    "desktop:build": "rustybuns build desktop",
    "test": "bun test test"
  },
  "dependencies": {
    "@builder.io/qwik": "1.20.2",
    "@builder.io/qwik-city": "1.20.2"
  },
  "devDependencies": {
    "@rustybuns/cli": "workspace:*",
    "@rustybuns/shell-bun": "workspace:*",
    "alchemy": "2.0.0-beta.77",
    "effect": "4.0.0-rc.112",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "wrangler": "4.141.0"
  }
}
