{
  "name": "qwik-example",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --mode ssr",
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "qwik build && wrangler pages deploy ./dist",
    "desktop:dev": "rustybuns build desktop --dev && rustybuns run desktop",
    "desktop:build": "rustybuns build desktop",
    "test": "bun test test"
  },
  "dependencies": {
    "@builder.io/qwik": "1.20.2",
    "@builder.io/qwik-city": "1.20.2"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
    "@alchemy.run/hetzner": "2.0.0-beta.84",
    "@alchemy.run/neon": "2.0.0-beta.84",
    "@alchemy.run/railway": "2.0.0-beta.84",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@rustybuns/cli": "^0.1.12",
    "@rustybuns/shell-bun": "^0.1.12",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.5",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "wrangler": "4.141.0"
  },
  "overrides": {
    "effect": "4.0.5",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/vitest": "4.0.5"
  }
}
