// Skate Tech Park online: the built page as static assets, and one World Durable Object per room
// (src/edge/worker.ts), four riders at most. `bun run deploy`.
{
  "name": "skatetechpark",
  "main": "src/edge/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "binding": "ASSETS", "directory": "dist/ui" },
  "durable_objects": { "bindings": [{ "name": "WORLD", "class_name": "World" }, { "name": "PURCHASES", "class_name": "Purchases" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }, { "tag": "v2", "new_sqlite_classes": ["Purchases"] }],
  "observability": { "enabled": true }
}
