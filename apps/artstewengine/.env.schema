# artstewengine secrets, by name and 1Password reference only, never values (varlock resolves them at deploy).
# @plugin(@varlock/1password-plugin@2.0.4)
# @initOp(allowAppAuth=true)
# ---

# 32 random bytes, base64. The key `bun run seal` in apps/qcrm encrypts the engine with; handed out only to paid licenses.
# @sensitive @required
ENGINE_KEY=op(op://qcrm/engine/key)

# Bearer token for granting and revoking payments.
# @sensitive @required
ADMIN_TOKEN=op(op://qcrm/engine/admin-token)
