# artstewengine secrets, by name and 1Password reference only, never values (varlock resolves them at deploy).
# @plugin(@varlock/1password-plugin@2.0.4)
# @initOp(allowAppAuth=true)
# ---

# Signs the admin session.
# @sensitive @required
BETTER_AUTH_SECRET=op(op://qcrm/engine/auth-secret)

# The one email allowed to make an account here.
# @sensitive @required
ADMIN_EMAIL=op(op://qcrm/engine/admin-email)

# 32 random bytes, base64. The key `bun run seal` in apps/qcrm encrypts the engine with; handed only to paid licenses.
# @sensitive @required
ENGINE_KEY=op(op://qcrm/engine/key)
