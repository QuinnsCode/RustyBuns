{
  "name": "git-recon",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "cms": "bun ../../packages/cms/src/cli.ts content --title \"Git Recon\" --port 4702",
    "build": "vite build",
    "test": "bun test",
    "snapshot": "bun scripts/snapshot.ts",
    "battle": "bun scripts/battle.ts",
    "desktop:dev": "rustybuns build desktop --dev --check && rustybuns run desktop",
    "desktop:build": "rustybuns build desktop --check",
    "edge:dev": "vite build && bunx wrangler dev",
    "deploy": "vite build && bunx wrangler deploy"
  },
  "dependencies": {
    "@rustybuns/models": "^0.1.12",
    "@rustybuns/terrain": "^0.1.12",
    "@rustybuns/game-controls": "^0.1.12",
    "@rustybuns/util": "^0.1.12",
    "@rustybuns/shell-bun": "^0.1.12",
    "lucide": "1.70.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@rustybuns/cli": "^0.1.12",
    "@types/three": "^0.180.0",
    "vite": "^6.4.4"
  }
}
