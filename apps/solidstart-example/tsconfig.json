{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "preserve", "jsxImportSource": "solid-js",
    "strict": true, "skipLibCheck": true, "noEmit": true, "isolatedModules": true, "allowImportingTsExtensions": true, "noUncheckedIndexedAccess": true,
    "types": ["bun", "vite/client"],
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src", "test"],
  "exclude": [".output", ".nitro"]
}
