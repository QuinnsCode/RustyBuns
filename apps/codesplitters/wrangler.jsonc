// GENERATED by rustybuns from rustybuns.config.ts. Alchemy owns the real
// infra; this file only feeds RWSDK's local dev. Do not hand-edit.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codesplitters",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "containers": [
    {
      "class_name": "AgentSandbox",
      "image": "sandbox/Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
    },
    {
      "class_name": "DeployRunner",
      "image": "deploy-sandbox/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codesplitters-db",
      "migrations_dir": "migrations"
    }
  ],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "codesplitters"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "HOOKS",
        "queue": "codesplitters-hooks"
      }
    ],
    "consumers": [
      {
        "queue": "codesplitters-hooks",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FILES",
        "class_name": "FileDurableObject"
      },
      {
        "name": "GAMES",
        "class_name": "GameRoom"
      },
      {
        "name": "AGENT_SANDBOX",
        "class_name": "AgentSandbox"
      },
      {
        "name": "DEPLOY_RUNNER",
        "class_name": "DeployRunner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FileDurableObject",
        "GameRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "DeployRunner"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "AgentSandbox"
      ]
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://codesplitters.notryanquinn.workers.dev",
    "ADMINS": "quinn"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 * * * *"
    ]
  }
}
