{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/cron-swanson": {
      "entry": [
        "src/page.html",
        "src/page.ts",
        "src/sync.ts",
        "src/cli.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "apps/at-lens": {
      "entry": [
        "index.html",
        "src/edge/worker.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  }
}
