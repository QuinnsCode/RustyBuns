{
  "name": "@rustybuns/cli",
  "type": "module",
  "version": "0.1.12",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuinnsCode/RustyBuns"
  },
  "homepage": "https://github.com/QuinnsCode/RustyBuns",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "description": "Box and ship the web app you already have: init, add desktop, build desktop, plan/deploy via Alchemy.",
  "bin": {
