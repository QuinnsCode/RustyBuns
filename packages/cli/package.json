  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./fit": "./src/glue/fit.ts",
    "./triage": "./src/triage.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "dependencies": {
    "@rustybuns/ports": "workspace:*",
    "@rustybuns/shell-bun": "workspace:*",
    "effect": "^4.0.5",
    "varlock": "1.22.0"
  },
  "keywords": [
    "rustybuns",
    "bun",
    "vite",
    "cloudflare",
    "alchemy",
    "desktop"
  ]
