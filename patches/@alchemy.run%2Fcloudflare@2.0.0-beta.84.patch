 const routeKey = (route: { pattern: string; zoneId: string }) => `${route.zoneId}:${route.pattern}`;
 
+/** The Cloudflare calls {@link attachWorkerRoute} makes; a test hands it a fake. */
+export interface WorkerRouteApi {
+  listRoutes: typeof workers.listRoutes;
+  createRoute: typeof workers.createRoute;
+  updateRoute: typeof workers.updateRoute;
+}
+
+// Same eventual-consistency window as `putDomain`: creating or pointing a
+// route right after `putScript` can race Cloudflare's script registry, which
+// rejects with code 10019 ("Cannot configure a route for a Worker which does
+// not exist") — typed as `RouteScriptNotFound` via the createRoute patch.
+const scriptRegistryRace = {
+  while: (error: { _tag: string }) => error._tag === "RouteScriptNotFound",
+  schedule: Schedule.max([Schedule.exponential(200), Schedule.recurs(15)]),
+};
+
+/**
+ * Attach `route` to `scriptName` when it is not attached yet. A route on the
+ * same pattern that already exists (made by hand, by an old wrangler deploy,
+ * or by a crashed reconcile) is adopted when it runs this Worker or no Worker,
+ * and fails naming the Worker it runs otherwise. A 409 `Conflict` (or the
+ * older 7003 `InvalidRoute`) on create means the route appeared since the
+ * listing, or the listing failed quietly: re-list and claim it the same way.
+ */
+export const attachWorkerRoute = (
+  route: { pattern: string; zoneId: string },
+  scriptName: string,
+  api: WorkerRouteApi = workers,
+) => {
+  const listZone = api.listRoutes({ zoneId: route.zoneId }).pipe(
+    Effect.map((response) => response.result ?? []),
+    Effect.orElseSucceed(() => [] as workers.RoutesListResultList),
+  );
+  const claim = Effect.fn(function* (zoneRoutes: workers.RoutesListResultList) {
+    const found = zoneRoutes.find((candidate) => candidate.pattern === route.pattern);
+    if (!found?.id) return undefined;
+    if (found.script && found.script !== scriptName) {
+      return yield* Effect.die(
+        new Error(
+          `Cannot attach route '${route.pattern}' to Worker '${scriptName}': ` +
+            `it already runs Worker '${found.script}'. To move it, edit the route in the ` +
+            `zone's Workers Routes in the Cloudflare dashboard and pick '${scriptName}' ` +
+            `(or delete it), then deploy again.`,
+        ),
+      );
+    }
+    if (!found.script) {
+      yield* api
+        .updateRoute({ zoneId: route.zoneId, routeId: found.id, pattern: route.pattern, script: scriptName })
+        .pipe(Effect.retry(scriptRegistryRace));
+    }
+    return { id: found.id, pattern: route.pattern, zoneId: route.zoneId, url: routePatternUrl(route.pattern) };
+  });
+  const reclaim = <E>(originalError: E) =>
+    Effect.gen(function* () {
+      const found = yield* claim(yield* listZone);
+      if (!found) return yield* Effect.fail(originalError);
+      return found;
+    });
+  return Effect.gen(function* () {
+    const claimed = yield* claim(yield* listZone);
+    if (claimed) return claimed;
+    return yield* api.createRoute({ zoneId: route.zoneId, pattern: route.pattern, script: scriptName }).pipe(
+      Effect.retry(scriptRegistryRace),
+      Effect.map((created) => ({
+        id: created.id,
+        pattern: created.pattern,
+        zoneId: route.zoneId,
+        url: routePatternUrl(created.pattern),
+      })),
+      Effect.catchTag("InvalidRoute", reclaim),
+      Effect.catchTag("Conflict", reclaim),
+    );
+  });
+};
+
