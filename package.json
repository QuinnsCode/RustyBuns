{
  "name": "rustybuns",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "publish:all": "for p in ports shell-bun native cli; do (cd packages/$p && bun publish --access public); done"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.0"
  },
  "version": "0.1.3",
  "license": "Apache-2.0"
}
