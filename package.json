{
  "name": "rustybuns",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "!apps/tscircuit-desktop"
  ],
  "scripts": {
    "typecheck": "bun scripts/typecheck.ts",
    "docs": "bun scripts/docs.ts",
    "site": "bun scripts/site.ts",
    "test": "bun test",
    "builder": "bun scripts/remote-ci.ts",
    "ios": "bun scripts/ios-sim.ts",
    "usdz": "bun scripts/usdz.ts",
    "manual": "bun scripts/manual-runs.ts",
    "publish:all": "bun scripts/check-release.ts && echo 'npm publishing runs in CI now (.github/workflows/npm-publish.yml): push the tag v<version> to publish.'",
    "deprecate:bad": "bun scripts/deprecate-bad.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "^5.9.0"
  },
  "version": "0.1.10",
  "license": "Apache-2.0",
  "dependencies": {
    "playcanvas": "^2.22.2"
  },
  "overrides": {
    "effect": "^4.0.5",
    "@effect/platform-bun": "^4.0.5",
    "@effect/platform-node": "^4.0.5",
    "@effect/platform-node-shared": "^4.0.5",
    "@effect/vitest": "^4.0.5",
    "hono": "^4.12.25",
    "@hono/node-server": "^1.19.10",
    "valibot": "^1.4.2",
    "lodash": "^4.18.1",
    "zod": "^4.6.6"
  },
  "patchedDependencies": {
    "@alchemy.run/cloudflare@2.0.0-beta.84": "patches/@alchemy.run%2Fcloudflare@2.0.0-beta.84.patch"
  }
}
