{
  "name": "rustybuns",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun scripts/typecheck.ts",
    "docs": "bun scripts/docs.ts",
    "site": "bun scripts/site.ts",
    "test": "bun test",
    "publish:all": "bun scripts/check-release.ts && echo 'npm publishing runs in CI now (.github/workflows/npm-publish.yml): push the tag v<version> to publish.'",
    "deprecate:bad": "bun scripts/deprecate-bad.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "^5.9.0"
  },
  "version": "0.1.10",
  "license": "Apache-2.0",
  "dependencies": {
    "playcanvas": "^2.22.2"
  },
  "overrides": {
    "effect": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112"
  },
  "patchedDependencies": {
    "alchemy@2.0.0-beta.77": "patches/alchemy@2.0.0-beta.77.patch"
  }
}
